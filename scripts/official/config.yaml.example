# ccextra 官方 Anthropic 订阅透传独立实例(127.0.0.1:8223)配置模板。
# 由 ./service.sh official-init(或开关 on 时的 start/restart)在 $CCEXTRA_OFFICIAL_DIR 下生成 config.yaml(0600,已存在不覆盖);
# 下面 proxy_url 的占位符在生成时替换为主实例 config.yaml 的 server.proxy_url。
# 约束:不设 secret_key、不设 payload;provider key 必须为空;base_url 只能是 https://api.anthropic.com;alias == name。
server:
  host: "127.0.0.1"
  port: 8223
  proxy_url: "@PROXY_URL@"
normalize:
  enabled: false
  drift_detector: false
logging:
  level: info
  request_body: false
providers:
  - name: anthropic-official
    protocol: anthropic_official
    base_url: https://api.anthropic.com
    models:
      - name: claude-opus-5-5
        alias: claude-opus-5-5
      - name: claude-sonnet-5-5
        alias: claude-sonnet-5-5
      - name: claude-haiku-5-5
        alias: claude-haiku-5-5
      # 未登记的 claude-… 快照名命中通配并原样转发
      - name: "claude-*"
        alias: "claude-*"
